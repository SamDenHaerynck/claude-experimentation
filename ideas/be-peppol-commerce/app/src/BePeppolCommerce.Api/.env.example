# Placeholder values only. Not loaded automatically: export these as environment variables (or use
# user-secrets / App Service settings). A double underscore separates configuration sections.
Storecove__ApiKey=replace-with-your-storecove-api-key
# Must be a positive integer (your Storecove legal entity id); 0 stops the host at startup once a key is set.
Storecove__LegalEntityId=0
Storecove__BaseUri=https://api.storecove.com/api/v2/
# Optional: Peppol ICD scheme -> Storecove scheme name. The Belgian name is unconfirmed; check
# Storecove's receiver identifier list before setting it. Unmapped schemes are sent unchanged.
# Storecove__SchemeMap__0208=replace-with-storecove-scheme-name
# Optional. When set, callers must send the same value in the X-Webhook-Secret header.
Webhook__Secret=replace-with-a-long-random-value
# Optional, Recommand only: the webhook's signing secret. When set, a request carrying a valid
# X-Signature: sha256=<hex> (HMAC-SHA256 of the raw body) is accepted without X-Webhook-Secret.
# Webhook__SigningSecret=replace-with-your-recommand-webhook-signing-secret

# Provider choice: "storecove" (default) or "recommand".
AccessPoint__Provider=storecove

# Recommand (used only when AccessPoint__Provider=recommand). Placeholders only.
Recommand__ApiKey=replace-with-your-recommand-api-key
Recommand__ApiSecret=replace-with-your-recommand-api-secret
Recommand__CompanyId=c_replace-with-your-company-id
Recommand__BaseUri=https://app.recommand.eu/
