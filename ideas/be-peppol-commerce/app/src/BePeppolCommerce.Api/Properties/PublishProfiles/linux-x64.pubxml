<Project>
  <!--
    Framework-dependent publish for a single platform. Without a RuntimeIdentifier, IKVM copies its
    runtime images for every platform into the output (about 340 MB, day 031); with linux-x64 it is
    about 92 MB. Use: dotnet publish src/BePeppolCommerce.Api -p:PublishProfile=linux-x64
    For Windows hosting, copy this file and change the RuntimeIdentifier to win-x64.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin/publish/linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
