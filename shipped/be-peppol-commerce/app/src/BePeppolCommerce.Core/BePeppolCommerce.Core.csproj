<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IKVM" Version="8.16.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!--
    Saxon-HE (MPL-2.0) runs the official Peppol/EN16931 Schematron XSLT. It is a Java library, so
    IKVM compiles it into a .NET assembly at build time. The jars are downloaded from Maven Central
    into obj/ on the first build (needs network access), checked against the pinned SHA-256 below,
    and never committed. The SHA-256 values were computed on day 028 from jars whose SHA-1 matched
    the .sha1 files Maven Central publishes next to them.
  -->
  <PropertyGroup>
    <JavaJarDir>$(MSBuildProjectDirectory)/obj/jars/</JavaJarDir>
    <MavenCentral>https://repo1.maven.org/maven2</MavenCentral>
  </PropertyGroup>

  <ItemGroup>
    <JavaJar Include="Saxon-HE-12.10.jar">
      <Url>$(MavenCentral)/net/sf/saxon/Saxon-HE/12.10/Saxon-HE-12.10.jar</Url>
      <Sha256>b571af282f25d7301059f788b9a149aab8b5cdc14ef3d212dc5425d3dcbb9a97</Sha256>
    </JavaJar>
    <JavaJar Include="xmlresolver-5.3.3.jar">
      <Url>$(MavenCentral)/org/xmlresolver/xmlresolver/5.3.3/xmlresolver-5.3.3.jar</Url>
      <Sha256>1fe4d5b92f708dcdb82dbce12919e0171e6b5ca62c6dca6220483625098feb5f</Sha256>
    </JavaJar>
  </ItemGroup>

  <ItemGroup>
    <IkvmReference Include="$(JavaJarDir)Saxon-HE-12.10.jar">
      <AssemblyName>Saxon.HE</AssemblyName>
      <References>$(JavaJarDir)xmlresolver-5.3.3.jar</References>
    </IkvmReference>
    <IkvmReference Include="$(JavaJarDir)xmlresolver-5.3.3.jar">
      <AssemblyName>xmlresolver</AssemblyName>
    </IkvmReference>
  </ItemGroup>

  <!-- Target batching: runs once per JavaJar. Downloads if missing, then always re-checks the hash,
       so a truncated or tampered file is caught. It must run before IKVM's
       _UpdateIkvmReferenceItemsMetadata, which reads the jars. -->
  <Target Name="DownloadJavaJars" BeforeTargets="_UpdateIkvmReferenceItemsMetadata;GetIkvmReferenceItems;ResolveIkvmReferences;ResolveAssemblyReferences"
          Outputs="%(JavaJar.Identity)">
    <PropertyGroup>
      <_JarPath>$(JavaJarDir)%(JavaJar.Identity)</_JarPath>
    </PropertyGroup>
    <DownloadFile Condition="!Exists('$(_JarPath)')" SourceUrl="%(JavaJar.Url)" DestinationFolder="$(JavaJarDir)"
                  DestinationFileName="%(JavaJar.Identity)" Retries="5" RetryDelayMilliseconds="20000" />
    <GetFileHash Files="$(_JarPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_JarHash" />
    </GetFileHash>
    <Delete Condition="'$(_JarHash)' != '%(JavaJar.Sha256)'" Files="$(_JarPath)" />
    <Error Condition="'$(_JarHash)' != '%(JavaJar.Sha256)'"
           Text="%(JavaJar.Identity): SHA-256 $(_JarHash) does not match the pinned %(JavaJar.Sha256). The file was deleted; build again." />
  </Target>

  <!--
    The official EN16931 / Peppol BIS 3.0 Schematron, pinned to OpenPEPPOL/peppol-bis-invoice-3 tag
    v3.0.20 (commit 261c458). OpenPeppol does not allow redistribution of the Peppol BIS without
    consent, so the files are downloaded into obj/ at build time (SHA-256 checked) and embedded,
    never committed. See Validation/Rules/SOURCE.md.
  -->
  <PropertyGroup>
    <SchDir>$(MSBuildProjectDirectory)/obj/sch/</SchDir>
    <PeppolRulesRaw>https://raw.githubusercontent.com/OpenPEPPOL/peppol-bis-invoice-3/261c458474e27d58a25be629cccac28883171c92/rules/sch</PeppolRulesRaw>
  </PropertyGroup>

  <ItemGroup>
    <SchFile Include="CEN-EN16931-UBL.sch">
      <Url>$(PeppolRulesRaw)/CEN-EN16931-UBL.sch</Url>
      <Sha256>bdcbb7b702cce55c7f8c789bef0cb9bebf6d376140c1776e683bd6d9bc0ad331</Sha256>
    </SchFile>
    <SchFile Include="PEPPOL-EN16931-UBL.sch">
      <Url>$(PeppolRulesRaw)/PEPPOL-EN16931-UBL.sch</Url>
      <Sha256>5ddf3a2f6633147b20b7805df9902d825af1a984f10014fcee186d4170364b1d</Sha256>
    </SchFile>
  </ItemGroup>

  <Target Name="DownloadSchematron" BeforeTargets="AssignTargetPaths;PrepareResources" Outputs="%(SchFile.Identity)">
    <PropertyGroup>
      <_SchPath>$(SchDir)%(SchFile.Identity)</_SchPath>
    </PropertyGroup>
    <DownloadFile Condition="!Exists('$(_SchPath)')" SourceUrl="%(SchFile.Url)" DestinationFolder="$(SchDir)"
                  DestinationFileName="%(SchFile.Identity)" Retries="5" RetryDelayMilliseconds="20000" />
    <GetFileHash Files="$(_SchPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_SchHash" />
    </GetFileHash>
    <Delete Condition="'$(_SchHash)' != '%(SchFile.Sha256)'" Files="$(_SchPath)" />
    <Error Condition="'$(_SchHash)' != '%(SchFile.Sha256)'"
           Text="%(SchFile.Identity): SHA-256 $(_SchHash) does not match the pinned %(SchFile.Sha256). The file was deleted; build again." />
    <ItemGroup>
      <EmbeddedResource Include="$(_SchPath)" LogicalName="BePeppolCommerce.Sch.%(SchFile.Identity)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Validation/Skeleton/*.xsl" LogicalName="BePeppolCommerce.Skeleton.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Validation/Schemas/UBL-2.1/**/*.xsd" LogicalName="BePeppolCommerce.Schemas.UBL-2.1/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
